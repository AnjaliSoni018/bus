generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  CASH
  OTHER
}

enum GatewayProvider {
  RAZORPAY
  STRIPE
  PAYPAL
  MOCK
}

enum RefundStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
}

model Payment {
  id                String          @id @default(uuid())
  bookingId         String          // from booking-service
  userId            String?
  amount            Float
  currency          String          @default("INR")
  method            PaymentMethod
  status            PaymentStatus   @default(PENDING)
  gateway           GatewayProvider
  gatewayOrderId    String?         // created during initiate
  gatewayPaymentId  String?         @unique
  failureReason     String?
  initiatedAt       DateTime        @default(now())
  completedAt       DateTime?

  attempts          Int             @default(1)
  metadata          Json?

  refunds           Refund[]
  events            PaymentEvent[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([gatewayOrderId])
}

model PaymentEvent {
  id          String    @id @default(uuid())
  paymentId   String
  type        String    // PAYMENT_INITIATED / PAYMENT_SUCCESS / PAYMENT_FAILED
  payload     Json?
  createdAt   DateTime  @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([type])
}

model Refund {
  id              String        @id @default(uuid())
  paymentId       String
  bookingId       String
  amount          Float
  status          RefundStatus  @default(INITIATED)
  reason          String?
  gatewayRefundId String?
  initiatedAt     DateTime      @default(now())
  completedAt     DateTime?

  metadata        Json?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([bookingId])
  @@index([status])
}

